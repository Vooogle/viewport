{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Viewport",
  "version": "1.0.0",
  "identifier": "com.viewport.app",
  "build": {
    "beforeDevCommand": "npm run dev:tauri -- --port 1420 --strictPort",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:tauri",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Viewport",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "deb",
      "rpm",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/vooogle/viewport/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5QzYwOURFMDY5QkJEOUYKUldTZnZac0czZ25HNlhmOFkrT2pwaWtWV0ZSa3pjQjhsNFUvVW9yQ0Rvelk4VzFhb29rTURoWmMK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
